# Environment files (keep the examples)
.env
!.env.example

# Editors / OS
/.vscode/
/.vercel/
.DS_Store

# Agent / tooling scratch
/opencode/

# Dependencies
/node_modules
/frontend/node_modules
/frontend/.pnp
/frontend/.pnp.js

# Build output
/frontend/build
/frontend/coverage

# Local Wrangler state. The Worker has its own .gitignore, but these are the
# paths that trip people up when they run wrangler from the repo root.
/worker/node_modules
/worker/dist
/worker/.wrangler
/worker/.dev.vars
/worker/worker-configuration.d.ts

# Logs
*.log
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*

# Python tooling for the validator scripts
__pycache__/
*.pyc
.pytest_cache/

# Local deployment record (contains secrets)
/deployment.sh
