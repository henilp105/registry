{
  // fpm-registry-api — Cloudflare Workers Free plan.
  //
  // Free-tier budget this config is designed against (see
  // docs/SERVERLESS_MIGRATION_PLAN.md §1):
  //   Workers      100,000 req/day · 10 ms CPU/invocation · 128 MB · 50 subrequests
  //   Durable Obj  100,000 req/day · 13,000 GB-s/day · 5 GB · 30 s CPU/request
  //   KV           100k reads + 1k writes/day · 1 GB
  //   R2           10 GB-month · free egress
  //
  // The 10 ms Worker CPU limit is the binding constraint. It is why the
  // MongoDB connection lives in a Durable Object (30 s CPU) instead of
  // being opened per request: a single PBKDF2-SHA256 round of MongoDB's
  // SCRAM handshake costs ~4.5 ms of CPU, so a cold connection inside a
  // handler reliably exceeds 10 ms and returns Cloudflare error 1102.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fpm-registry-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Explicit CPU ceiling. Cloudflare recommends setting this to prevent
  // runaway bills on the paid plan; on free it bounds error 1102 blast radius.
  "limits": {
    "cpu_ms": 10
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  "vars": {
    "ENVIRONMENT": "development",
    "MONGO_DB_NAME": "fpmregistry",
    "PBKDF2_ITERATIONS": "210000",
    "HOST": "http://localhost:5173",
    // Both loopback spellings. `localhost` and `127.0.0.1` are different
    // origins to a browser, and which one a developer uses depends on their
    // tooling -- CRA serves on localhost, but a container or a Playwright script
    // reaches 127.0.0.1. With only one listed, the other silently fails closed
    // and the symptom is a blank page with no error in any log: the browser
    // blocks the response before the app can report it.
    //
    // Still an allow-list, not a wildcard. Loopback only, which cannot be reached
    // from off-machine.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    // Secrets are NOT in this file. Set with:
    //   wrangler secret put JWT_SECRET_KEY
    //   wrangler secret put VALIDATION_SECRET
    //   wrangler secret put BREVO_API_KEY
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "MONGO_POOL",
        "class_name": "MongoPool"
      }
    ]
  },

  // Declares the Durable Object's lifecycle. Wrangler treats `migrations` and
  // `exports` as mutually exclusive ways of saying the same thing -- declaring
  // both is a hard config error, so this file uses `exports` and carries no
  // `migrations` array.
  //
  // `storage: sqlite` is the modern default and is not billed on the free plan.
  // The class stores nothing in `ctx.storage`; it exists to own the MongoDB
  // connection and to give the KDF a 30 s CPU budget instead of 10 ms.
  "exports": {
    "MongoPool": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "r2_buckets": [
    {
      "binding": "TARBALLS",
      "bucket_name": "fpm-registry-tarballs",
      "preview_bucket_name": "fpm-registry-tarballs-preview"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],

  "triggers": {
    // 5 cron triggers are available on the free plan; we use 3.
    "crons": [
      "17 * * * *",   // hourly   — ensure MongoDB indexes exist (bootstrap)
      "0 3 * * *",    // 03:00 UTC— sweep expired upload/auth tokens
      "0 4 * * 0"     // 04:00 Sun— prune orphaned tarballs from R2
    ]
  },

  // ── Environment inheritance, which is the trap here ─────────────────────
  // `vars`, `durable_objects` and `kv_namespaces` are NOT inherited by an
  // `env` block. Each environment below therefore repeats them explicitly.
  //
  // Omitting the repetition is silent: `wrangler deploy --env production` prints
  // no error, and produces a Worker with no MONGO_POOL and no CACHE. Every route
  // that touches MongoDB then fails, and the cause is a config block three
  // hundred lines away from the symptom. Verified by running
  // `wrangler deploy --dry-run --env production` and reading its binding table.
  "env": {
    "staging": {
      "name": "fpm-registry-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "MONGO_DB_NAME": "fpmregistry_staging",
        "PBKDF2_ITERATIONS": "210000",
        "HOST": "https://staging.registry.fortran-lang.org",
        "ALLOWED_ORIGINS": "https://staging.registry.fortran-lang.org"
      },
      "durable_objects": {
        "bindings": [{ "name": "MONGO_POOL", "class_name": "MongoPool" }]
      },
      "kv_namespaces": [
        { "binding": "CACHE", "id": "REPLACE_WITH_STAGING_KV_NAMESPACE_ID" }
      ],
      "exports": {
        "MongoPool": { "type": "durable-object", "storage": "sqlite" }
      },
      "r2_buckets": [
        {
          "binding": "TARBALLS",
          "bucket_name": "fpm-registry-tarballs-staging"
        }
      ]
    },
    "production": {
      "name": "fpm-registry-api",
      "vars": {
        "ENVIRONMENT": "production",
        "MONGO_DB_NAME": "fpmregistry",
        "PBKDF2_ITERATIONS": "210000",
        "HOST": "https://registry.fortran-lang.org",
        "ALLOWED_ORIGINS": "https://registry.fortran-lang.org"
      },
      "durable_objects": {
        "bindings": [{ "name": "MONGO_POOL", "class_name": "MongoPool" }]
      },
      "kv_namespaces": [
        { "binding": "CACHE", "id": "REPLACE_WITH_PRODUCTION_KV_NAMESPACE_ID" }
      ],
      "exports": {
        "MongoPool": { "type": "durable-object", "storage": "sqlite" }
      },
      "r2_buckets": [
        {
          "binding": "TARBALLS",
          "bucket_name": "fpm-registry-tarballs"
        }
      ]
    }
  }
}