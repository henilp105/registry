# Fortran Package Registry - Environment Configuration
# Copy this file to .env and customize the values
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up -d

# ===========================================
# Frontend Configuration
# ===========================================

# Port to expose the frontend (default: 80)
FRONTEND_PORT=80

# ===========================================
# Backend Configuration
# ===========================================

# MongoDB database name
MONGO_DB_NAME=fpmregistry

# MongoDB credentials (leave empty for no auth)
MONGO_USER_NAME=
MONGO_PASSWORD=

# Security salt for password hashing (CHANGE THIS!)
SALT=your_secure_random_salt_here

# JWT secret key for token signing (CHANGE THIS!)
JWT_SECRET_KEY=your_secure_jwt_secret_here

# Hostname for the application
HOST=localhost

# ===========================================
# Email Configuration (Optional)
# For password reset functionality
# ===========================================

# SMTP email address for sending reset emails
RESET_EMAIL=

# SMTP password for the email account
RESET_PASSWORD=

# ===========================================
# Admin Configuration
# ===========================================

# Password for sudo/admin operations (CHANGE THIS!)
SUDO_PASSWORD=admin

# Token guarding GET /latency, presented as `X-Admin-Token`. Defect D113: that
# endpoint was unauthenticated and cost ~15+ database round-trips per request.
# Left blank it stays closed -- an unset token must not mean "no token required".
#   export LATENCY_ADMIN_TOKEN=$(node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
LATENCY_ADMIN_TOKEN=
