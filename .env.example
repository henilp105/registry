# Fortran Package Registry - Environment Configuration
# Copy this file to .env and customize the values
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up -d

# ===========================================
# Frontend Configuration
# ===========================================

# Port to expose the frontend (default: 80)
FRONTEND_PORT=80

# API origin baked into the frontend bundle at build time. Leave empty in the
# default docker-compose shape: the outer nginx serves the frontend and proxies
# the API on the same origin, so a relative base URL is correct. Set an absolute
# URL (e.g. https://api.example.org) only for a split-host deployment.
REACT_APP_REGISTRY_API_URL=

# ===========================================
# Backend Configuration
# ===========================================

# MongoDB database name
MONGO_DB_NAME=fpmregistry

# MongoDB credentials (leave empty for no auth)
MONGO_USER_NAME=
MONGO_PASSWORD=

# Security salt for password hashing. Required — the compose files use ${SALT:?...},
# so an unset value stops the deployment instead of substituting a default that
# is printed in this repository (defect D126).
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SALT=

# JWT secret key for token signing. Required, same reasoning.
JWT_SECRET_KEY=

# Hostname for the application
HOST=localhost

# ===========================================
# Email Configuration (Optional)
# For password reset functionality
# ===========================================

# SMTP email address for sending reset emails
RESET_EMAIL=

# SMTP password for the email account
RESET_PASSWORD=

# ===========================================
# Admin Configuration
# ===========================================

# Password for sudo/admin operations. Required: it bootstraps the first admin
# account, so the old default of `admin` meant any deployment that forgot to set
# it shipped with an `admin`/`admin` account (defect D126).
SUDO_PASSWORD=

# Token guarding GET /latency, presented as `X-Admin-Token`. Defect D113: that
# endpoint was unauthenticated and cost ~15+ database round-trips per request.
# Left blank it stays closed -- an unset token must not mean "no token required".
#   export LATENCY_ADMIN_TOKEN=$(node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
LATENCY_ADMIN_TOKEN=
