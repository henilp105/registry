# Frontend production build configuration.
#
# REACT_APP_REGISTRY_API_URL is inlined into the bundle by CRA's DefinePlugin at
# build time, so it has to be set *while building*, not at runtime. The variable
# name is frozen by the API contract and must not change.
#
# Overrides, in order of precedence:
#   1. shell   -> REACT_APP_REGISTRY_API_URL=https://api.example.org npm run build
#   2. file    -> create frontend/.env.production.local (gitignored)
#   3. docker  -> docker compose build --build-arg \
#                    REACT_APP_REGISTRY_API_URL=https://api.example.org
#
# The default below is the public production API host. It is a placeholder for
# a build environment, not a deployment target - prefer passing the real origin
# at build time rather than editing this file.
REACT_APP_REGISTRY_API_URL=https://registry.fortran-lang.org
